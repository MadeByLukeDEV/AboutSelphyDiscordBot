# Copy to .env.local (repo root). Both apps and the Prisma CLI read it.
# Plain-hex secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- shared ----------------------------------------------------------------
# Shared AboutSelphy Postgres. Plain URL (no ?schema=); URL-encode the password.
DATABASE_URL="postgres://aboutselphy_bot:password@host:5432/aboutselphy"
# "bot" in production, "bot_dev" locally (dev and prod must NOT share data).
DATABASE_SCHEMA="bot_dev"
# local | production. Side-effecting jobs (Twitch, YouTube, scheduled
# announcements) only run in production unless BOT_INTEGRATIONS_IN_DEV=true.
BOT_ENV="local"
BOT_INTEGRATIONS_IN_DEV="false"
# Bearer secret for the bot's internal API (dashboard -> bot).
BOT_API_SECRET=""
# AES-256-GCM key for stored tokens (32 bytes hex). Changing it = reconnect.
TOKEN_ENCRYPTION_KEY=""
# Twitch application (dev.twitch.tv/console), same one the other aboutselphy apps use.
# Register the redirect URL <NEXT_PUBLIC_SITE_URL>/api/twitch/callback for it
# (http://localhost:3004/api/twitch/callback locally). Both apps read these:
# the dashboard for the one-time "Connect Twitch", the bot for EventSub and Helix.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# YouTube (new video announcements): an API key for the YouTube Data API v3 (plain key,
# not the OAuth client) and the channel's ID (starts with UC, not the @handle).
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Feed announcer: internal host names it may read although they are on the private network, comma
# separated (for example the name of your RSSHub service in Dokploy). Everything else must be a public
# https address.
RSS_INTERNAL_HOSTS=""

# ---- bot ---------------------------------------------------------------------
# Use a SEPARATE dev application + a test server locally. Never the prod token.
DISCORD_BOT_TOKEN=""
DISCORD_APP_ID=""
DISCORD_GUILD_ID=""
# Role IDs (comma separated) that count as staff. Same values as the auth service.
DISCORD_ADMIN_ROLE_IDS=""
DISCORD_MODERATOR_ROLE_IDS=""
# Set to true once the privileged Message Content intent is switched on in the Developer Portal:
# ticket transcripts, message edit/delete logs, the counting channel and auto-responders need it.
DISCORD_MESSAGE_CONTENT="false"
BOT_API_PORT="3100"
# Where the internal API listens. Default: 127.0.0.1 locally, 0.0.0.0 when BOT_ENV=production
# (the dashboard container reaches it over the Docker network; never publish the port).
# BOT_API_HOST=""

# ---- dashboard ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3004"
BOT_API_URL="http://127.0.0.1:3100"
# Central auth (auth.aboutselphy.com). Add http://localhost:3004 to the auth
# service's TRUSTED_ORIGINS, run the auth service on :3000.
AUTH_URL="http://localhost:3000"
AUTH_DATABASE_URL="postgres://aboutselphy_auth_reader:password@host:5432/aboutselphy"
AUTH_DATABASE_SCHEMA="auth"
BETTER_AUTH_SECRET="same-secret-as-the-auth-service"
AUTH_COOKIE_PREFIX="better-auth"
