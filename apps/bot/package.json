{
  "name": "@aboutselphy/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @aboutselphy/db ensure-client",
    "dev": "tsx watch src/index.ts",
    "prestart": "pnpm --filter @aboutselphy/db ensure-client",
    "start": "tsx src/index.ts",
    "commands:register": "tsx scripts/register-commands.ts",
    "invite-url": "tsx scripts/invite-url.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aboutselphy/db": "workspace:*",
    "@aboutselphy/shared": "workspace:*",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@napi-rs/canvas": "1.0.10",
    "discord.js": "14.27.0",
    "dotenv": "^18.0.3",
    "pino": "10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
