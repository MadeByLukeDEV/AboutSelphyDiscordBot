{
  "name": "aboutselphy-discordbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:bot": "pnpm --filter @aboutselphy/bot dev",
    "dev:dashboard": "pnpm --filter @aboutselphy/dashboard dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "commands:register": "pnpm --filter @aboutselphy/bot commands:register"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
