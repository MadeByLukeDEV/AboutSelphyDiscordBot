// One schema, one commented section per module. The Postgres schema ("bot" in
// production, "bot_dev" locally) is chosen at runtime / by prisma7.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- core -------------------------------------------------------------

/// Small key/value store for the bot's own bookkeeping (e.g. the hash of the
/// last registered slash commands, so we only re-register on change).
model BotSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---- moderation -------------------------------------------------------
// Single guild, so case numbers are one global sequence. CHECK constraints
// (singleton id, digits-only Discord IDs) are added to the migration by hand:
// Prisma can't express them.

enum ModCaseType {
  warn
  timeout
  untimeout
  kick
  ban
  unban
  note
  antibot
}

/// Where a case came from: a slash command, the dashboard, an action done
/// directly in Discord's UI (read from the audit log), or an automatic rule.
enum ModCaseSource {
  command
  dashboard
  audit_log
  automod
}

enum ModEscalationAction {
  timeout
  kick
  ban
}

/// Singleton (id = 1): moderation settings and the case counter.
model ModConfig {
  id                        Int                  @id @default(1)
  /// The number the next case gets. Incremented atomically in the same
  /// transaction that inserts the case, so numbers are never reused.
  nextCaseNumber            Int                  @default(1)
  /// Channel that receives one embed per case. Null = logging off.
  logChannelId              String?              @db.VarChar(20)
  /// Try to DM the member before a kick/ban and on warn/timeout.
  dmOnAction                Boolean              @default(true)
  /// Escalation: every N-th active warning of a member triggers `escalationAction`.
  /// Null threshold = off.
  escalationThreshold       Int?
  escalationAction          ModEscalationAction?
  /// How long a timeout lasts (or a temporary ban); null on a ban = permanent.
  escalationDurationSeconds Int?
  /// Only warnings from the last N days count towards the threshold; null = all active warnings.
  escalationWindowDays      Int?
  updatedAt                 DateTime             @updatedAt
}

model ModCase {
  id               String        @id @default(cuid())
  caseNumber       Int           @unique
  type             ModCaseType
  source           ModCaseSource
  /// Discord ID of the member the case is about.
  targetId         String        @db.VarChar(20)
  /// Name at the time of the action (members can rename or leave).
  targetName       String?       @db.VarChar(100)
  /// Discord ID of the moderator, or "system" for automatic rules.
  moderatorId      String        @db.VarChar(20)
  moderatorName    String?       @db.VarChar(100)
  reason           String?       @db.VarChar(1000)
  /// Timeouts: how long it lasts. Null for everything else.
  durationSeconds  Int?
  expiresAt        DateTime?
  /// Warnings can be pardoned (false) without deleting the history.
  active           Boolean       @default(true)
  /// Who pardoned it and when. The pardoner is a dashboard user: their id in
  /// the central auth service (not a Discord ID) plus a name snapshot.
  pardonedAt       DateTime?
  pardonedByUserId String?       @db.VarChar(64)
  pardonedByName   String?       @db.VarChar(100)
  /// Where the case embed was posted, so edits can update it.
  logChannelId     String?       @db.VarChar(20)
  logMessageId     String?       @db.VarChar(20)
  /// Temporary bans: set once the ban was lifted (or found already lifted), so it
  /// is never lifted twice. Null on a ban with an expiry = still to do.
  expiryHandledAt  DateTime?
  createdAt        DateTime      @default(now())

  @@index([targetId, createdAt])
  @@index([type, createdAt])
  @@index([expiryHandledAt, expiresAt])
}

// ---- temporary voice channels -------------------------------------------
// The room's live state (locked, limit, video, soundboard, who may join) is the
// Discord channel itself: its permission overwrites and settings are the source
// of truth, so nothing here can drift from what members actually experience.

/// Singleton (id = 1): the settings every lobby shares.
model TempVoiceConfig {
  id                  Int      @id @default(1)
  /// Master switch. Off = joining any lobby does nothing (open rooms are still
  /// deleted when they empty).
  enabled             Boolean  @default(false)
  /// Names containing one of these (case-insensitive) are refused.
  blockedWords        String[] @default([])
  /// Also refuse the built-in list of common insults and slurs (English and
  /// German, defined in packages/shared). On by default.
  useDefaultBlocklist Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// A "join to create" lobby. Each one has its own category, name, limit and
/// defaults, so a gaming lobby and a chill lobby can behave differently.
model TempVoiceLobby {
  id                       String   @id @default(cuid())
  /// The voice channel people join to get their own room.
  channelId                String   @unique @db.VarChar(20)
  /// Category the rooms are created in. Null = the lobby's own category.
  categoryId               String?  @db.VarChar(20)
  /// Room name; {user} becomes the owner's display name.
  nameTemplate             String   @default("{user}'s room") @db.VarChar(100)
  /// 0 = no limit.
  defaultUserLimit         Int      @default(0)
  allowVideoByDefault      Boolean  @default(true)
  allowSoundboardByDefault Boolean  @default(true)
  /// Pause just this lobby.
  enabled                  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// One row per room the bot created, so it can find them again after a restart
/// and never touches a channel it didn't make.
model TempVoiceChannel {
  id             String   @id @default(cuid())
  channelId      String   @unique @db.VarChar(20)
  ownerId        String   @db.VarChar(20)
  /// The lobby channel the room was created from (for the dashboard). Not a
  /// foreign key: removing a lobby must not touch rooms people are using.
  lobbyChannelId String?  @db.VarChar(20)
  /// The control panel message posted in the room, so it can be edited.
  panelMessageId String?  @db.VarChar(20)
  createdAt      DateTime @default(now())

  @@index([ownerId])
}

// ---- twitch (went live) -------------------------------------------------
// CHECK constraints (singleton ids, digits-only Discord IDs) are added to the
// migration by hand.

/// Singleton (id = 1): the Twitch account the bot listens with. EventSub over
/// WebSocket needs a USER access token (an app token is refused), but no scopes
/// for stream.online/offline, so the stored grant can do nothing else.
model TwitchConnection {
  id              Int      @id @default(1)
  twitchUserId    String   @db.VarChar(32)
  login           String   @db.VarChar(64)
  /// AES-256-GCM (purpose "twitch-bot-refresh-token"); never the plain token.
  refreshTokenEnc String   @db.Text
  /// The refresh token was rejected: someone must connect again.
  needsReconnect  Boolean  @default(false)
  connectedByName String?  @db.VarChar(100)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Singleton (id = 1): switches for the whole module.
model TwitchConfig {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  /// Edit the message when the stream ends (title struck through, "ended").
  markEndedOnOffline Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

/// A channel to announce. Up to a handful; each has its own Discord channel.
model TwitchStreamer {
  id              String   @id @default(cuid())
  twitchUserId    String   @unique @db.VarChar(32)
  login           String   @db.VarChar(64)
  displayName     String   @db.VarChar(100)
  /// Discord channel the announcement goes to.
  channelId       String   @db.VarChar(20)
  /// Role to ping, or null for no ping.
  pingRoleId      String?  @db.VarChar(20)
  /// Text above the embed; {name} {title} {game} {url} are replaced.
  messageTemplate String   @default("{name} is live: {title}") @db.VarChar(300)
  /// Embed colour as a 24-bit number (default: Twitch purple, 0x9146ff).
  embedColor      Int      @default(9520895)
  /// Show Twitch's stream preview picture in the announcement.
  showThumbnail   Boolean  @default(true)
  /// Show the game field.
  showGame        Boolean  @default(true)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// One row per announced broadcast. Unique on Twitch's stream id, so a replay
/// after a reconnect or restart never posts twice.
model TwitchNotification {
  id             String    @id @default(cuid())
  twitchStreamId String    @unique @db.VarChar(32)
  twitchUserId   String    @db.VarChar(32)
  /// Snapshot for editing the message when the stream ends.
  login          String    @db.VarChar(64)
  displayName    String    @db.VarChar(100)
  title          String    @default("") @db.VarChar(300)
  game           String    @default("") @db.VarChar(200)
  channelId      String    @db.VarChar(20)
  /// Null = a silent baseline: the stream was already running when the bot
  /// first saw it, so nothing was posted (and nothing will be edited).
  messageId      String?   @db.VarChar(20)
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([twitchUserId, endedAt])
}
