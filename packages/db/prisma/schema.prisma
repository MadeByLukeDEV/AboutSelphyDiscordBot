// One schema, one commented section per module. The Postgres schema ("bot" in
// production, "bot_dev" locally) is chosen at runtime / by prisma7.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- core -------------------------------------------------------------

/// Small key/value store for the bot's own bookkeeping (e.g. the hash of the
/// last registered slash commands, so we only re-register on change).
model BotSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---- moderation -------------------------------------------------------
// Single guild, so case numbers are one global sequence. CHECK constraints
// (singleton id, digits-only Discord IDs) are added to the migration by hand:
// Prisma can't express them.

enum ModCaseType {
  warn
  timeout
  untimeout
  kick
  ban
  unban
  note
  antibot
}

/// Where a case came from: a slash command, the dashboard, an action done
/// directly in Discord's UI (read from the audit log), or an automatic rule.
enum ModCaseSource {
  command
  dashboard
  audit_log
  automod
}

enum ModEscalationAction {
  timeout
  kick
  ban
}

/// Singleton (id = 1): moderation settings and the case counter.
model ModConfig {
  id                        Int                  @id @default(1)
  /// The number the next case gets. Incremented atomically in the same
  /// transaction that inserts the case, so numbers are never reused.
  nextCaseNumber            Int                  @default(1)
  /// Channel that receives one embed per case. Null = logging off.
  logChannelId              String?              @db.VarChar(20)
  /// Try to DM the member before a kick/ban and on warn/timeout.
  dmOnAction                Boolean              @default(true)
  /// Escalation: every N-th active warning of a member triggers `escalationAction`.
  /// Null threshold = off.
  escalationThreshold       Int?
  escalationAction          ModEscalationAction?
  /// How long a timeout lasts (or a temporary ban); null on a ban = permanent.
  escalationDurationSeconds Int?
  /// Only warnings from the last N days count towards the threshold; null = all active warnings.
  escalationWindowDays      Int?
  updatedAt                 DateTime             @updatedAt
}

model ModCase {
  id               String        @id @default(cuid())
  caseNumber       Int           @unique
  type             ModCaseType
  source           ModCaseSource
  /// Discord ID of the member the case is about.
  targetId         String        @db.VarChar(20)
  /// Name at the time of the action (members can rename or leave).
  targetName       String?       @db.VarChar(100)
  /// Discord ID of the moderator, or "system" for automatic rules.
  moderatorId      String        @db.VarChar(20)
  moderatorName    String?       @db.VarChar(100)
  reason           String?       @db.VarChar(1000)
  /// Timeouts: how long it lasts. Null for everything else.
  durationSeconds  Int?
  expiresAt        DateTime?
  /// Warnings can be pardoned (false) without deleting the history.
  active           Boolean       @default(true)
  /// Who pardoned it and when. The pardoner is a dashboard user: their id in
  /// the central auth service (not a Discord ID) plus a name snapshot.
  pardonedAt       DateTime?
  /// The reason was changed afterwards by staff (who and when); the log message is refreshed.
  reasonEditedAt     DateTime?
  reasonEditedByName String?       @db.VarChar(100)
  pardonedByUserId String?       @db.VarChar(64)
  pardonedByName   String?       @db.VarChar(100)
  /// Where the case embed was posted, so edits can update it.
  logChannelId     String?       @db.VarChar(20)
  logMessageId     String?       @db.VarChar(20)
  /// Temporary bans: set once the ban was lifted (or found already lifted), so it
  /// is never lifted twice. Null on a ban with an expiry = still to do.
  expiryHandledAt  DateTime?
  createdAt        DateTime      @default(now())

  @@index([targetId, createdAt])
  @@index([type, createdAt])
  @@index([expiryHandledAt, expiresAt])
}

// ---- temporary voice channels -------------------------------------------
// The room's live state (locked, limit, video, soundboard, who may join) is the
// Discord channel itself: its permission overwrites and settings are the source
// of truth, so nothing here can drift from what members actually experience.

/// Singleton (id = 1): the settings every lobby shares.
model TempVoiceConfig {
  id                  Int      @id @default(1)
  /// Master switch. Off = joining any lobby does nothing (open rooms are still
  /// deleted when they empty).
  enabled             Boolean  @default(false)
  /// Names containing one of these (case-insensitive) are refused.
  blockedWords        String[] @default([])
  /// Also refuse the built-in list of common insults and slurs (English and
  /// German, defined in packages/shared). On by default.
  useDefaultBlocklist Boolean  @default(true)
  /// Remember each owner's last room (name, limit, lock, video, soundboard) and give it to their next one.
  rememberSettings    Boolean  @default(false)
  /// Move members who stay self-deafened this many minutes into the server's AFK channel (0 = off).
  afkMoveMinutes      Int      @default(0)
  updatedAt           DateTime @updatedAt
}

/// Per-role rules for temporary rooms: the best bitrate and the highest member limit among the owner's roles win.
/// roleId is a role ID, or "everyone" for the base rule (the @everyone role).
model TempVoiceRoleRule {
  id           String   @id @default(cuid())
  roleId       String   @unique @db.VarChar(20)
  /// Bitrate for new rooms in kbit/s (8-384); capped to what the server's boost level allows. Null = Discord's default.
  bitrateKbps  Int?
  /// The most members an owner with this role may allow in their room (1-99). Null = no cap from this rule.
  maxUserLimit Int?
  createdAt    DateTime @default(now())
}

/// A "join to create" lobby. Each one has its own category, name, limit and
/// defaults, so a gaming lobby and a chill lobby can behave differently.
model TempVoiceLobby {
  id                       String   @id @default(cuid())
  /// The voice channel people join to get their own room.
  channelId                String   @unique @db.VarChar(20)
  /// Category the rooms are created in. Null = the lobby's own category.
  categoryId               String?  @db.VarChar(20)
  /// Room name; {user} becomes the owner's display name.
  nameTemplate             String   @default("{user}'s room") @db.VarChar(100)
  /// 0 = no limit.
  defaultUserLimit         Int      @default(0)
  allowVideoByDefault      Boolean  @default(true)
  allowSoundboardByDefault Boolean  @default(true)
  /// Pause just this lobby.
  enabled                  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// One row per room the bot created, so it can find them again after a restart
/// and never touches a channel it didn't make.
model TempVoiceChannel {
  id             String   @id @default(cuid())
  channelId      String   @unique @db.VarChar(20)
  ownerId        String   @db.VarChar(20)
  /// The lobby channel the room was created from (for the dashboard). Not a
  /// foreign key: removing a lobby must not touch rooms people are using.
  lobbyChannelId String?  @db.VarChar(20)
  /// The control panel message posted in the room, so it can be edited.
  panelMessageId String?  @db.VarChar(20)
  createdAt      DateTime @default(now())

  @@index([ownerId])
}

// ---- twitch (went live) -------------------------------------------------
// CHECK constraints (singleton ids, digits-only Discord IDs) are added to the
// migration by hand.

/// Singleton (id = 1): the Twitch account the bot listens with. EventSub over
/// WebSocket needs a USER access token (an app token is refused), but no scopes
/// for stream.online/offline, so the stored grant can do nothing else.
model TwitchConnection {
  id              Int      @id @default(1)
  twitchUserId    String   @db.VarChar(32)
  login           String   @db.VarChar(64)
  /// AES-256-GCM (purpose "twitch-bot-refresh-token"); never the plain token.
  refreshTokenEnc String   @db.Text
  /// The refresh token was rejected: someone must connect again.
  needsReconnect  Boolean  @default(false)
  connectedByName String?  @db.VarChar(100)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Singleton (id = 1): switches for the whole module.
model TwitchConfig {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  /// Edit the message when the stream ends (title struck through, "ended").
  markEndedOnOffline Boolean  @default(true)
  /// Role worn by a streamer's linked Discord member while they are live; null = off.
  liveRoleId         String?  @db.VarChar(20)
  /// New clips of channels with postClips are posted here; null = no clips.
  clipsChannelId     String?  @db.VarChar(20)
  updatedAt          DateTime @updatedAt
}

/// A channel to announce. Up to a handful; each has its own Discord channel.
model TwitchStreamer {
  id              String   @id @default(cuid())
  twitchUserId    String   @unique @db.VarChar(32)
  login           String   @db.VarChar(64)
  displayName     String   @db.VarChar(100)
  /// Discord channel the announcement goes to.
  channelId       String   @db.VarChar(20)
  /// Role to ping, or null for no ping.
  pingRoleId      String?  @db.VarChar(20)
  /// The streamer's Discord account: it gets the live role while this channel is live.
  discordUserId   String?  @db.VarChar(20)
  /// Text above the embed; {name} {title} {game} {url} are replaced.
  messageTemplate String   @default("{name} is live: {title}") @db.VarChar(300)
  /// Embed colour as a 24-bit number (default: Twitch purple, 0x9146ff).
  embedColor      Int      @default(9520895)
  /// Show Twitch's stream preview picture in the announcement.
  showThumbnail   Boolean  @default(true)
  /// Show the game field.
  showGame        Boolean  @default(true)
  enabled         Boolean  @default(true)
  /// Post this channel's new clips in TwitchConfig.clipsChannelId.
  postClips       Boolean  @default(false)
  /// When its clips were last checked (null = never: the first check only remembers).
  clipsCheckedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A clip that was seen (and posted, or silently remembered), so it is never posted twice.
model TwitchClip {
  id           String   @id @default(cuid())
  clipId       String   @unique @db.VarChar(100)
  twitchUserId String   @db.VarChar(32)
  seenAt       DateTime @default(now())

  @@index([seenAt])
}

/// One row per announced broadcast. Unique on Twitch's stream id, so a replay
/// after a reconnect or restart never posts twice.
model TwitchNotification {
  id             String    @id @default(cuid())
  twitchStreamId String    @unique @db.VarChar(32)
  twitchUserId   String    @db.VarChar(32)
  /// Snapshot for editing the message when the stream ends.
  login          String    @db.VarChar(64)
  displayName    String    @db.VarChar(100)
  title          String    @default("") @db.VarChar(300)
  game           String    @default("") @db.VarChar(200)
  channelId      String    @db.VarChar(20)
  /// Null = a silent baseline: the stream was already running when the bot
  /// first saw it, so nothing was posted (and nothing will be edited).
  messageId      String?   @db.VarChar(20)
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([twitchUserId, endedAt])
}

// ---- announcements ----------------------------------------------------------
// Staff compose a message in the dashboard; the bot sends it (now or at a set
// time) and can edit or delete it afterwards. CHECK constraints (digits-only
// Discord IDs, a colour range, "has something to say", scheduled has a time)
// are added to the migration by hand.

enum AnnouncementStatus {
  draft
  scheduled
  sending
  sent
  failed
}

model Announcement {
  id               String             @id @default(cuid())
  status           AnnouncementStatus @default(draft)
  /// Plain text above the embed (may be empty when there is an embed).
  content          String             @default("") @db.VarChar(2000)
  embedEnabled     Boolean            @default(false)
  embedTitle       String             @default("") @db.VarChar(256)
  embedDescription String             @default("") @db.VarChar(4000)
  /// 24-bit colour; default is the brand green #00FFA8.
  embedColor       Int                @default(65448)
  /// https only; Discord loads it, the dashboard never does.
  embedImageUrl    String             @default("") @db.VarChar(500)
  channelId        String             @db.VarChar(20)
  /// The one role that is mentioned, or null for no ping.
  pingRoleId       String?            @db.VarChar(20)
  /// Also mention @everyone (admins only; the bot needs Mention Everyone for it to ping).
  pingEveryone     Boolean            @default(false)
  /// When to send it. "Send now" sets this to the current time.
  scheduledFor     DateTime?
  sentAt           DateTime?
  /// The posted message, so it can be edited or deleted later.
  messageId        String?            @db.VarChar(20)
  /// A short code (never Discord's text) when sending failed.
  lastError        String             @default("") @db.VarChar(40)
  /// "none" | "daily" | "weekly" | "monthly": after each send the row is scheduled again for the next time.
  repeat           String             @default("none") @db.VarChar(8)
  /// No further sends after this time.
  repeatUntil      DateTime?
  createdByUserId  String             @db.VarChar(64)
  createdByName    String             @db.VarChar(100)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, scheduledFor])
  @@index([createdAt])
}

// ---- youtube (new video uploads) ------------------------------------------------
// The bot polls the channel's uploads playlist and announces new public videos.
// CHECK constraints (singleton id, digits-only Discord IDs, colour range) are
// added to the migration by hand.

/// Singleton (id = 1): settings and the poller's last result.
model YoutubeConfig {
  id              Int       @id @default(1)
  enabled         Boolean   @default(false)
  /// Discord channel the announcement goes to.
  channelId       String?   @db.VarChar(20)
  /// Role to ping, or null for no ping.
  pingRoleId      String?   @db.VarChar(20)
  /// Text above the embed; {title} {channel} {url} are replaced.
  messageTemplate String    @default("New video: {title}") @db.VarChar(300)
  /// Announce Shorts (videos of 3 minutes or less) too.
  announceShorts  Boolean   @default(false)
  /// A "Watch" link button under the announcement.
  showWatchButton Boolean   @default(true)
  /// Announce scheduled premieres / upcoming broadcasts ahead of time (once; the video is not announced again when it starts).
  announcePremieres Boolean @default(false)
  /// {title} {channel} {url} {time} (the start, as a relative Discord time).
  premiereTemplate String   @default("Premiere {time}: {title}") @db.VarChar(300)
  embedColor      Int       @default(16711680)
  /// When the poller last got an answer from YouTube, and a short code if it failed.
  lastCheckedAt   DateTime?
  lastError       String    @default("") @db.VarChar(40)
  updatedAt       DateTime  @updatedAt
}

/// Every upload the bot has seen. Unique on the video id, so a video is announced once.
model YoutubeVideo {
  id          String    @id @default(cuid())
  videoId     String    @unique @db.VarChar(20)
  title       String    @db.VarChar(300)
  publishedAt DateTime
  isShort     Boolean   @default(false)
  /// Null = remembered silently (the first run, a Short we skip, or announcing is off).
  messageId   String?   @db.VarChar(20)
  announcedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

// ---- role panels ------------------------------------------------------------------
// A message with buttons or a menu where members pick their own roles. The panel is
// posted by the bot; clicking toggles a role. CHECK constraints (digits-only Discord
// IDs, colour range, 1..25 roles are enforced in code) are added by hand.

enum RolePanelStyle {
  buttons
  menu
  /// Members react to the message with an emoji to get the role.
  reactions
}

model RolePanel {
  id            String          @id @default(cuid())
  channelId     String          @db.VarChar(20)
  /// The posted message. Null = not published yet (a draft).
  messageId     String?         @db.VarChar(20)
  title         String          @default("") @db.VarChar(256)
  description   String          @default("") @db.VarChar(2000)
  /// 24-bit colour; default is the brand green #00FFA8.
  color         Int             @default(65448)
  /// A big picture under the text (https only; Discord loads it, the dashboard never does).
  imageUrl      String          @default("") @db.VarChar(500)
  style         RolePanelStyle  @default(buttons)
  /// Picking one role removes the panel's other roles ("choose one").
  exclusive     Boolean         @default(false)
  createdByName String          @db.VarChar(100)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  roles         RolePanelRole[]

  @@index([createdAt])
}

model RolePanelRole {
  id          String    @id @default(cuid())
  panelId     String
  panel       RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roleId      String    @db.VarChar(20)
  label       String    @db.VarChar(80)
  /// A unicode emoji, or one of the server's emotes as "<:name:id>" / "<a:name:id>".
  emoji       String    @default("") @db.VarChar(64)
  /// Shown under the label in a menu.
  description String    @default("") @db.VarChar(100)
  position    Int       @default(0)

  @@unique([panelId, roleId])
  @@index([panelId, position])
}

// ---- welcome, auto-roles and role persistence --------------------------------------
// CHECK constraints (singleton, digits-only Discord IDs, colour range, https picture, list
// sizes) are added to the migration by hand.

/// Singleton (id = 1).
model WelcomeConfig {
  id                  Int      @id @default(1)
  /// Roles given to every new member / every new bot (each must be safe to hand out; checked
  /// by the bot every time). At most 5 each.
  autoRoleIds         String[] @default([])
  botAutoRoleIds      String[] @default([])
  /// Give a returning member back the (safe) roles they had when they left.
  restoreRoles        Boolean  @default(false)
  welcomeEnabled      Boolean  @default(false)
  welcomeChannelId    String?  @db.VarChar(20)
  /// Up to 10 variants; the bot picks one at random for each member. Placeholders: {user} (a
  /// mention), {username}, {server}, {count} (member number).
  welcomeTemplates    String[] @default(["Welcome to {server}, {user}! You are member #{count}."])
  /// A picture made for each member (their name, avatar and number on a background): see
  /// WelcomeCardImage for the image the admin provides.
  welcomeCardEnabled  Boolean  @default(false)
  /// How the admin's image is used: "background" (full size, darkened) or "sticker" (on the right
  /// of a plain background).
  welcomeCardMode     String   @default("background") @db.VarChar(12)
  welcomeCardTitle    String   @default("Welcome") @db.VarChar(40)
  /// {username} {server} {count}
  welcomeCardSubtitle String   @default("Member #{count}") @db.VarChar(80)
  /// Post it as a box (embed) instead of plain text.
  welcomeAsEmbed      Boolean  @default(true)
  welcomeColor        Int      @default(65448)
  /// https picture shown in the box; "" = none.
  welcomeImageUrl     String   @default("") @db.VarChar(500)
  /// Also send the new member a direct message.
  dmEnabled           Boolean  @default(false)
  dmTemplate          String   @default("Welcome to {server}! Have a look at the rules and say hi.") @db.VarChar(1000)
  goodbyeEnabled      Boolean  @default(false)
  goodbyeChannelId    String?  @db.VarChar(20)
  goodbyeTemplate     String   @default("{username} has left the server.") @db.VarChar(1000)
  updatedAt           DateTime @updatedAt
}

/// Singleton (id = 1): the image the admin uploaded for the welcome card.
model WelcomeCardImage {
  id             Int      @id @default(1)
  data           Bytes
  contentType    String   @db.VarChar(20)
  width          Int
  height         Int
  uploadedByName String   @db.VarChar(100)
  uploadedAt     DateTime @default(now())
}

/// The roles a member had when they left, kept for a limited time so they can be restored.
model MemberRoleSnapshot {
  userId  String   @id @db.VarChar(20)
  roleIds String[]
  savedAt DateTime @default(now())

  @@index([savedAt])
}

// ---- server logs ------------------------------------------------------------------
// One row per kind of log (members, memberUpdates, voice, server), each with its own
// channel and an on/off switch. CHECK constraints (known category, digits-only channel,
// "on" needs a channel) are added to the migration by hand.

model LogRoute {
  id        String   @id @default(cuid())
  category  String   @unique @db.VarChar(24)
  channelId String?  @db.VarChar(20)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---- leveling ------------------------------------------------------------------------
// XP from messages (with a cooldown) and from time in voice, levels from the MEE6 curve,
// role rewards at chosen levels. CHECK constraints (singleton, ranges, digits-only IDs)
// are added to the migration by hand.

/// Singleton (id = 1).
model LevelConfig {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  /// XP per message is a random number in [xpMin, xpMax], at most once per cooldown.
  xpMin             Int      @default(15)
  xpMax             Int      @default(25)
  cooldownSeconds   Int      @default(60)
  /// XP for each minute in a voice channel with someone else (0 = off).
  voiceXpPerMinute  Int      @default(5)
  /// "off" | "same" (in the channel where it happened) | "channel" (announceChannelId)
  announce          String   @default("same") @db.VarChar(8)
  announceChannelId String?  @db.VarChar(20)
  /// {user} (a mention) {username} {level}
  announceTemplate  String   @default("GG {user}, you reached level {level}!") @db.VarChar(300)
  /// Channels and roles that earn no XP.
  noXpChannelIds    String[] @default([])
  noXpRoleIds       String[] @default([])
  /// Keep every reward role up to the member's level (true), or only the highest (false).
  stackRoles        Boolean  @default(true)
  /// Show the top members on a public web page (/leaderboard on the dashboard's address). Off by default.
  publicLeaderboard Boolean  @default(false)
  /// Voice XP only for members who are not muted (self or server).
  voiceRequiresUnmuted Boolean @default(false)
  /// "off" | "weekly" | "monthly": everyone's XP is wiped at the start of each period (UTC).
  resetEvery        String   @default("off") @db.VarChar(8)
  /// When the last period reset (or its first recording) happened.
  lastResetAt       DateTime?
  updatedAt         DateTime @updatedAt
}

/// A role given when a member reaches a level.
model LevelReward {
  id        String   @id @default(cuid())
  level     Int      @unique
  roleId    String   @db.VarChar(20)
  createdAt DateTime @default(now())
}

model MemberXp {
  userId       String   @id @db.VarChar(20)
  xp           Int      @default(0)
  messages     Int      @default(0)
  voiceMinutes Int      @default(0)
  /// Last known name, for the leaderboard of people who have left.
  name         String   @default("") @db.VarChar(100)
  /// The member asked to be left off the public web page (they still appear inside Discord).
  hidden       Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@index([xp])
}

// ---- tickets -------------------------------------------------------------------------
// A panel message with an "Open ticket" button; each ticket is a private channel. Closing
// saves a transcript (when the bot can read message text) and deletes the channel. CHECK
// constraints (singleton, digits-only IDs, ranges, status) are added by hand.

enum TicketStatus {
  open
  closed
}

/// Singleton (id = 1).
model TicketConfig {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  /// Where the panel message is posted, and the posted message.
  panelChannelId   String?  @db.VarChar(20)
  panelMessageId   String?  @db.VarChar(20)
  /// Category the ticket channels are created in.
  categoryId       String?  @db.VarChar(20)
  /// Roles that can see, claim and close every ticket (at most 5).
  staffRoleIds     String[] @default([])
  /// Where the summary and transcript of a closed ticket go.
  logChannelId     String?  @db.VarChar(20)
  /// How many tickets one member can have open at once.
  maxOpenPerUser   Int      @default(1)
  panelTitle       String   @default("Need help?") @db.VarChar(256)
  panelDescription String   @default("Press the button to open a private ticket with the team.") @db.VarChar(2000)
  panelColor       Int      @default(65448)
  buttonLabel      String   @default("Open a ticket") @db.VarChar(80)
  /// The first message in a new ticket. {user} mentions the opener, {number} is the ticket number.
  welcomeTemplate  String   @default("Hi {user}, thanks for opening ticket #{number}. Tell us what you need and the team will be with you soon.") @db.VarChar(1000)
  /// The number the next ticket gets; incremented atomically with the insert.
  nextNumber       Int      @default(1)
  /// Ask what the ticket is about (a short form) before the channel is made.
  askReason        Boolean  @default(false)
  /// DM the opener a 1-5 star rating after the ticket is closed.
  askRating        Boolean  @default(false)
  /// Close a ticket after this many hours without a message (0 = never; CHECK 0..720 in the migration).
  autoCloseHours   Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model Ticket {
  id            String       @id @default(cuid())
  number        Int          @unique
  /// The private channel. Unique while it exists.
  channelId     String       @unique @db.VarChar(20)
  openerId      String       @db.VarChar(20)
  openerName    String       @default("") @db.VarChar(100)
  status        TicketStatus @default(open)
  claimedById   String?      @db.VarChar(20)
  claimedByName String?      @db.VarChar(100)
  createdAt     DateTime     @default(now())
  closedAt      DateTime?
  closedById    String?      @db.VarChar(20)
  closedByName  String?      @db.VarChar(100)
  closeReason   String       @default("") @db.VarChar(300)
  /// What the opener said it is about (empty when the form is off).
  topic         String       @default("") @db.VarChar(300)
  /// The category the opener picked (no foreign key: a removed category leaves its tickets alone) and its name at the time.
  categoryId    String?      @db.VarChar(40)
  categoryLabel String       @default("") @db.VarChar(80)
  /// The opener's rating after closing (1-5), once.
  rating        Int?
  /// The last message in the ticket channel (or when it was opened); drives the automatic close.
  lastActivityAt DateTime     @default(now())
  /// The conversation as JSON (see packages/shared/src/tickets.ts), kept when the ticket closes.
  /// Null when the bot could not read message text.
  transcript    Json?
  messageCount  Int          @default(0)

  @@index([status, createdAt])
  @@index([openerId, status])
  @@index([status, lastActivityAt])
}

// ---- giveaways ---------------------------------------------------------------------
// Staff create a giveaway in the dashboard; the bot posts it with an "Enter" button, ends it
// at the set time (restart-safe) and picks the winners at random. CHECK constraints
// (digits-only IDs, winner count, ends after it was made) are added by hand.

enum GiveawayStatus {
  draft
  active
  ended
  cancelled
}

model Giveaway {
  id             String          @id @default(cuid())
  status         GiveawayStatus  @default(draft)
  channelId      String          @db.VarChar(20)
  /// The posted message. Null until the giveaway is started.
  messageId      String?         @db.VarChar(20)
  prize          String          @db.VarChar(200)
  description    String          @default("") @db.VarChar(1000)
  winnerCount    Int             @default(1)
  endsAt         DateTime
  /// Only members with this role can enter (and win). Null = everyone.
  requiredRoleId String?         @db.VarChar(20)
  /// Role mentioned when the giveaway starts. Null = nobody.
  pingRoleId     String?         @db.VarChar(20)
  /// Members with this role get `bonusEntries` extra chances in the draw (e.g. boosters). Null = no bonus.
  bonusRoleId    String?         @db.VarChar(20)
  bonusEntries   Int             @default(0)
  /// Entry requirements beyond a role (0 = none): Discord account age, time in this server, leveling level.
  minAccountDays Int             @default(0)
  minMemberDays  Int             @default(0)
  minLevel       Int             @default(0)
  /// When it was posted (the length of one round, for repeating).
  startedAt      DateTime?
  /// How many more rounds follow once this one ends: each new round copies the settings and lasts as long as this one did (0 = none).
  repeatsLeft    Int             @default(0)
  hostName       String          @db.VarChar(100)
  hostUserId     String          @db.VarChar(64)
  /// Discord IDs of the winners of the last draw (a re-roll replaces them).
  winners        String[]        @default([])
  endedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        GiveawayEntry[]

  @@index([status, endsAt])
  /// Optional picture (https only), shown big in the post.
  imageUrl String @default("") @db.VarChar(500)
}

model GiveawayEntry {
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@id([giveawayId, userId])
}

// ---- suggestions ---------------------------------------------------------------------
// Members post suggestions with /suggest; others vote with buttons; the team approves,
// denies or marks them implemented. CHECK constraints (singleton, digits-only IDs, ranges)
// are added by hand.

enum SuggestionStatus {
  open
  approved
  denied
  implemented
}

/// Singleton (id = 1).
model SuggestionConfig {
  id              Int      @id @default(1)
  enabled         Boolean  @default(false)
  /// Where suggestions are posted.
  channelId       String?  @db.VarChar(20)
  /// A member can post a suggestion at most this often.
  cooldownSeconds Int      @default(60)
  /// The number the next suggestion gets; incremented atomically.
  nextNumber      Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model Suggestion {
  id             String           @id @default(cuid())
  number         Int              @unique
  authorId       String           @db.VarChar(20)
  authorName     String           @default("") @db.VarChar(100)
  content        String           @db.VarChar(1500)
  status         SuggestionStatus @default(open)
  channelId      String           @db.VarChar(20)
  messageId      String           @db.VarChar(20)
  /// Who decided: a Discord member (decidedById) or a dashboard user (name only).
  decidedById    String?          @db.VarChar(20)
  decidedByName  String?          @db.VarChar(100)
  decisionReason String           @default("") @db.VarChar(300)
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  /// Closed as a duplicate of this suggestion number (votes were moved there).
  mergedIntoNumber Int?
  votes          SuggestionVote[]
  comments       SuggestionComment[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

/// A private note a team member left on a suggestion (never shown to members).
model SuggestionComment {
  id           String     @id @default(cuid())
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  authorName   String     @db.VarChar(100)
  body         String     @db.VarChar(500)
  createdAt    DateTime   @default(now())

  @@index([suggestionId, createdAt])
}

model SuggestionVote {
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String     @db.VarChar(20)
  /// +1 or -1
  value        Int
  createdAt    DateTime   @default(now())

  @@id([suggestionId, userId])
}

// ---- polls ---------------------------------------------------------------------------
// A question with 2 to 10 options and a button for each; members vote (one choice or several),
// the results update live, and the poll ends at its time (restart-safe). Votes are anonymous.
// CHECK constraints (digits-only IDs, option count) are added by hand.

enum PollStatus {
  draft
  active
  ended
}

model Poll {
  id            String     @id @default(cuid())
  status        PollStatus @default(draft)
  channelId     String     @db.VarChar(20)
  /// The posted message. Null until started.
  messageId     String?    @db.VarChar(20)
  question      String     @db.VarChar(300)
  options       String[]
  /// Members may pick several options.
  multiple      Boolean    @default(false)
  /// When the poll closes; null = until a team member ends it.
  endsAt        DateTime?
  createdById   String     @db.VarChar(64)
  createdByName String     @db.VarChar(100)
  createdAt     DateTime   @default(now())
  endedAt       DateTime?
  /// When it was posted (set when it starts).
  startedAt     DateTime?
  /// Post a reminder this many minutes before it ends (0 = none). Needs endsAt.
  remindBeforeMinutes Int      @default(0)
  /// When the reminder was posted, so it happens once.
  reminderSentAt DateTime?
  votes         PollVote[]

  @@index([status, endsAt])
  /// Optional picture (https only), shown big in the post.
  imageUrl String @default("") @db.VarChar(500)
}

model PollVote {
  pollId      String
  poll        Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String @db.VarChar(20)
  optionIndex Int

  @@id([pollId, userId, optionIndex])
}

/// Starboard: messages that collect enough of one reaction are re-posted in a showcase channel.
model StarboardConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  /// Where starred messages are re-posted.
  channelId String?  @db.VarChar(20)
  /// One unicode emoji.
  emoji     String   @default("⭐") @db.VarChar(16)
  /// Reactions needed (not counting the bot, nor the author unless allowSelf).
  threshold Int      @default(3)
  allowSelf Boolean  @default(false)
  /// Channels (or whole categories) whose messages never reach the starboard.
  ignoredChannelIds String[] @default([])
  updatedAt DateTime @updatedAt
}

model StarboardPost {
  sourceMessageId String   @id @db.VarChar(20)
  sourceChannelId String   @db.VarChar(20)
  authorId        String   @db.VarChar(20)
  authorName      String   @db.VarChar(100)
  /// A short plain-text snippet for the dashboard list.
  excerpt         String   @db.VarChar(200)
  jumpUrl         String   @db.VarChar(200)
  /// The re-post in the starboard channel; null while the message is below the threshold.
  boardMessageId  String?  @db.VarChar(20)
  stars           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stars])
}

/// A member who marked themselves away with /afk (their next message ends it).
model AfkStatus {
  userId String   @id @db.VarChar(20)
  reason String   @default("") @db.VarChar(100)
  since  DateTime @default(now())
}

/// Birthdays: members choose their own day and month (never the year); the bot celebrates them.
model BirthdayConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  /// Where the greeting is posted.
  channelId String?  @db.VarChar(20)
  /// Optional role worn for the day.
  roleId    String?  @db.VarChar(20)
  /// {user} (a mention of the member) and {name}.
  message   String   @default("🎂 Happy birthday {user}!") @db.VarChar(300)
  /// IANA time zone that decides when a day starts for everyone.
  timeZone  String   @default("Europe/Berlin") @db.VarChar(64)
  updatedAt DateTime @updatedAt
  /// Optional picture the bot draws (avatar, name, date) on the admin's own image; see MemberCardImage.
  cardEnabled  Boolean @default(false)
  cardMode     String  @default("background") @db.VarChar(12)
  cardTitle    String  @default("Happy birthday") @db.VarChar(40)
  /// {date} is replaced.
  cardSubtitle String  @default("{date}") @db.VarChar(80)
  /// Greeting for milestone ages (18, 21, 25, 30, then every ten years); empty = the normal message. {age} is replaced.
  milestoneMessage String @default("") @db.VarChar(300)
  /// On the first round of each month, post who has a birthday that month.
  monthlySummary Boolean @default(false)
  /// "YYYY-MM" of the last summary (or of the moment it was switched on, which posts nothing).
  lastSummaryMonth String? @db.VarChar(7)
}

model Birthday {
  userId           String   @id @db.VarChar(20)
  /// Only for the dashboard list; refreshed whenever the member sets their date.
  displayName      String   @db.VarChar(100)
  month            Int
  day              Int
  /// Optional, only if the member (or staff, on request) gave it: used for {age} and milestones, never shown as a date.
  year             Int?
  /// "YYYY-MM-DD" of the last day this member was celebrated, so a restart never greets twice.
  lastCelebratedOn String?  @db.VarChar(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([month, day])
}

/// Reminders: /remind in:2h message:... pings the member (DM first) when the time comes.
model ReminderConfig {
  id         Int      @id @default(1)
  enabled    Boolean  @default(true)
  /// Pending reminders one member may have.
  maxPerUser Int      @default(10)
  /// The one channel /remind works in; null = anywhere.
  channelId  String?  @db.VarChar(20)
  updatedAt  DateTime @updatedAt
  /// Optional picture drawn for each reminder; see MemberCardImage.
  cardEnabled Boolean @default(false)
  cardMode    String  @default("background") @db.VarChar(12)
  cardTitle   String  @default("Reminder") @db.VarChar(40)
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(20)
  /// Where it was set; used if the member's DMs are closed.
  channelId   String    @db.VarChar(20)
  message     String    @db.VarChar(500)
  remindAt    DateTime
  /// Where the member wants it: dm (the channel is the fallback) or channel (the DM is the fallback).
  delivery    String    @default("dm") @db.VarChar(8)
  createdAt   DateTime  @default(now())
  /// Set when delivery was claimed; a reminder is delivered once.
  deliveredAt DateTime?
  /// Repeating: seconds between occurrences (null = once) and how many more follow.
  repeatEverySeconds Int?
  repeatsLeft        Int       @default(0)
  /// Set when a snooze button was used on this delivered reminder (each reminder can be snoozed once).
  snoozedAt          DateTime?

  @@index([deliveredAt, remindAt])
  @@index([userId, deliveredAt])
}

/// Stat channels: a voice channel whose name shows a live number ("Members: 123").
model StatChannel {
  id        String   @id @default(cuid())
  channelId String   @unique @db.VarChar(20)
  /// members | humans | bots | boosts | channels | roles | voice (CHECK in the migration).
  kind      String   @db.VarChar(20)
  /// Must contain {count}.
  template  String   @db.VarChar(90)
  /// The name the bot last set; the dashboard shows it.
  lastName  String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The image an admin uploaded for a member card (birthday, reminder). One row per kind.
model MemberCardImage {
  kind           String   @id @db.VarChar(12)
  data           Bytes
  contentType    String   @db.VarChar(20)
  width          Int
  height         Int
  uploadedByName String   @db.VarChar(100)
  uploadedAt     DateTime @default(now())
}

/// A message the bot keeps at the bottom of a channel: when people write, it deletes its old copy and posts it again.
model StickyMessage {
  id            String   @id @default(cuid())
  channelId     String   @unique @db.VarChar(20)
  /// Staff-written text (markdown allowed, never pings).
  content       String   @db.VarChar(1500)
  enabled       Boolean  @default(true)
  /// The copy currently at the bottom, so the bot can delete it.
  lastMessageId String?  @db.VarChar(20)
  /// Set by the dashboard on every change; the bot posts again and clears it.
  dirty         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Announcement channels whose messages the bot publishes (crossposts) to every server that follows them.
model AutoPublishChannel {
  channelId String   @id @db.VarChar(20)
  createdAt DateTime @default(now())
}

/// Custom commands ("tags"): staff-written answers members get with /tag name.
model CustomCommand {
  id            String   @id @default(cuid())
  /// Lowercase letters, digits, "-" and "_" (CHECK in the migration).
  name          String   @unique @db.VarChar(32)
  /// Markdown allowed; {user} {username} {server} are replaced; never pings anyone but the member who asked.
  response      String   @db.VarChar(1800)
  /// Only the member who asked sees the answer.
  ephemeral     Boolean  @default(false)
  enabled       Boolean  @default(true)
  uses          Int      @default(0)
  createdByName String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The counting channel: members count up one by one; a wrong number or the same member twice breaks the streak.
model CountingConfig {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  channelId        String?  @db.VarChar(20)
  /// The last correct number (0 = start with 1).
  currentCount     Int      @default(0)
  highScore        Int      @default(0)
  /// Who counted last, so they can't count twice in a row (unless allowConsecutive).
  lastUserId       String?  @db.VarChar(20)
  allowConsecutive Boolean  @default(false)
  /// A wrong number resets the count to 0 (otherwise it is only refused).
  resetOnMistake   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

/// Auto-responders: the bot answers when a message contains a trigger word or phrase.
model AutoResponder {
  id              String   @id @default(cuid())
  /// Compared in lower case, ignoring accents tricks (NFKC) and invisible characters.
  trigger         String   @db.VarChar(100)
  /// word | contains | exact (CHECK in the migration).
  matchType       String   @default("word") @db.VarChar(12)
  response        String   @db.VarChar(1500)
  /// Wait this long before answering again in the same channel.
  cooldownSeconds Int      @default(30)
  /// Limit to these channels; empty = everywhere.
  channelIds      String[] @default([])
  enabled         Boolean  @default(true)
  uses            Int      @default(0)
  createdByName   String   @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// The central on/off switch of a feature (see @aboutselphy/shared/modules). No row = on. A switched-off
/// feature answers no commands or buttons and its passive handlers do nothing; its data and settings are kept.
model ModuleFlag {
  key           String   @id @db.VarChar(24)
  enabled       Boolean  @default(true)
  updatedByName String   @db.VarChar(100)
  updatedAt     DateTime @updatedAt
}

/// An address other services POST to (/api/webhooks/in/<id>, signed with HMAC); the bot relays the message into a Discord channel.
model WebhookEndpoint {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(60)
  channelId     String    @db.VarChar(20)
  /// The shared signing secret, AES-256-GCM encrypted (purpose "webhook-endpoint-secret"). Shown once, when created.
  secretEnc     String
  /// generic (our own signing scheme) | github | kofi (CHECK in the migration). Fixed when the endpoint is made.
  provider      String    @default("generic") @db.VarChar(8)
  enabled       Boolean   @default(true)
  lastUsedAt    DateTime?
  uses          Int       @default(0)
  createdByName String    @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A place the bot sends events to: a Discord webhook (formatted message) or any https address (signed JSON).
model OutboundWebhook {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(60)
  /// discord | generic (CHECK in the migration).
  kind          String    @db.VarChar(10)
  /// The address, encrypted (purpose "webhook-outbound-url"): a Discord webhook address is a secret.
  urlEnc        String
  /// Generic only: the signing secret, encrypted (purpose "webhook-outbound-secret"). Shown once.
  secretEnc     String?
  /// Which events it receives (see @aboutselphy/shared/webhooks).
  events        String[]  @default([])
  enabled       Boolean   @default(true)
  /// "ok", "http 500", "blocked", "error" ... of the last attempt.
  lastStatus    String?   @db.VarChar(24)
  lastAt        DateTime?
  /// Deliveries that failed in a row (after retries). Reset by a success or when it is switched on again.
  failStreak    Int       @default(0)
  /// Set when the bot switched it off after too many failures in a row.
  autoDisabledAt DateTime?
  createdByName String    @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A feed (RSS or Atom address) the bot watches; new items are announced in a channel. TikTok, Instagram and
/// more come through a feed bridge such as RSSHub.
model FeedSource {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(60)
  /// The feed address, AES-256-GCM encrypted (purpose "feed-url"): bridges often carry an access key in it.
  urlEnc          String
  channelId       String    @db.VarChar(20)
  /// Role to ping, or null for no ping.
  pingRoleId      String?   @db.VarChar(20)
  /// {title} {link} {name} are replaced (plain text; the title is escaped).
  messageTemplate String    @default("{name}: {title} {link}") @db.VarChar(300)
  intervalMinutes Int       @default(10)
  /// Only items whose title contains one of these (case-insensitive) are announced; empty = all.
  includeWords    String[]  @default([])
  /// Items whose title contains one of these are never announced.
  excludeWords    String[]  @default([])
  /// Post a link embed (title, source, time) instead of the plain text message.
  useEmbed        Boolean   @default(false)
  enabled         Boolean   @default(true)
  /// false until the first successful check, which only remembers what is there (nothing is announced).
  baselined       Boolean   @default(false)
  lastCheckedAt   DateTime?
  /// "ok", "http 404", "blocked", "timeout", "parse", "empty" ... of the last check.
  lastStatus      String?   @db.VarChar(24)
  createdByName   String    @db.VarChar(100)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           FeedItem[]
}

/// Items already seen (announced or silently remembered), so nothing is announced twice.
model FeedItem {
  id        String     @id @default(cuid())
  feedId    String
  feed      FeedSource @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid      String     @db.VarChar(300)
  createdAt DateTime   @default(now())

  @@unique([feedId, guid])
}

/// The moderators' guide: the text around the command list and where the bot posted it (singleton, id 1).
model ModGuide {
  id          Int       @id @default(1)
  channelId   String?   @db.VarChar(20)
  title       String    @default("Moderator guide") @db.VarChar(100)
  description String    @default("") @db.VarChar(1500)
  /// Cover picture, https only (checked by the dashboard and again by the bot).
  imageUrl    String    @default("") @db.VarChar(500)
  color       String    @default("#00FFA8") @db.VarChar(7)
  notes       String    @default("") @db.VarChar(1500)
  /// The posted messages in order, so an update edits them instead of posting again.
  messageIds  String[]
  postedAt    DateTime?
  updatedAt   DateTime  @updatedAt
}

/// The anti-bot channel: whoever writes in it is timed out and kicked (singleton, id 1).
model AntiBotConfig {
  id             Int       @id @default(1)
  enabled        Boolean   @default(false)
  channelId      String?   @db.VarChar(20)
  /// Timeout length before the kick, 60 s to 28 days (CHECK in the migration).
  timeoutSeconds Int       @default(604800)
  /// Log only: nothing is deleted, timed out or kicked.
  dryRun         Boolean   @default(false)
  /// Members caught so far and when the last one was.
  hits           Int       @default(0)
  lastHitAt      DateTime?
  updatedAt      DateTime  @updatedAt
}

/// The Twitch VIP role: settings, and the result of the last sync (singleton, id 1).
model TwitchVipConfig {
  id         Int       @id @default(1)
  enabled    Boolean   @default(false)
  roleId     String?   @db.VarChar(20)
  /// unknown | ok | missingScope | notConnected | needsReconnect | unavailable (CHECK in the migration).
  status     String    @default("unknown") @db.VarChar(16)
  vipCount   Int       @default(0)
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt
}

/// A member's claim "this Twitch account is mine", until staff approve it. Only approved links earn the role.
model TwitchVipLink {
  id             String    @id @default(cuid())
  discordUserId  String    @unique @db.VarChar(20)
  discordName    String    @db.VarChar(100)
  twitchUserId   String    @unique @db.VarChar(32)
  twitchLogin    String    @db.VarChar(64)
  approved       Boolean   @default(false)
  approvedByName String?   @db.VarChar(100)
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([approved])
}

/// How long personal data is kept before a daily job removes it (singleton, id 1). 0 = keep.
model RetentionConfig {
  id                   Int       @id @default(1)
  ticketTranscriptDays Int       @default(0)
  caseDays             Int       @default(0)
  suggestionDays       Int       @default(0)
  inactiveXpDays       Int       @default(0)
  pollDays             Int       @default(0)
  giveawayDays         Int       @default(0)
  starboardDays        Int       @default(0)
  lastRunAt            DateTime?
  /// What the last run removed, in words (never personal data).
  lastResult           String    @default("") @db.VarChar(300)
  updatedAt            DateTime  @updatedAt
}

/// What a member's last temporary room looked like, so their next one starts the same (only while rememberSettings is on).
model TempVoicePreference {
  userId            String   @id @db.VarChar(20)
  name              String   @db.VarChar(100)
  userLimit         Int      @default(0)
  locked            Boolean  @default(false)
  videoAllowed      Boolean  @default(true)
  soundboardAllowed Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// XP boost: members with this role earn `percent` % of the normal XP (150 = one and a half times). The highest applicable boost counts.
model LevelBoost {
  id        String   @id @default(cuid())
  roleId    String   @unique @db.VarChar(20)
  percent   Int
  createdAt DateTime @default(now())
}

/// The verification gate (singleton, id 1): new members press a button (and maybe answer a question) to get a role.
model VerificationConfig {
  id                 Int       @id @default(1)
  enabled            Boolean   @default(false)
  channelId          String?   @db.VarChar(20)
  panelMessageId     String?   @db.VarChar(20)
  verifiedRoleId     String?   @db.VarChar(20)
  /// Given on join, taken away on verifying. Optional.
  unverifiedRoleId   String?   @db.VarChar(20)
  panelTitle         String    @default("Welcome! Please verify") @db.VarChar(256)
  panelDescription   String    @default("Press the button below to confirm you are a real person and get access to the server.") @db.VarChar(2000)
  buttonLabel        String    @default("Verify") @db.VarChar(80)
  /// Optional question (typed into a form) and its answer.
  question           String    @default("") @db.VarChar(200)
  answer             String    @default("") @db.VarChar(100)
  minAccountAgeDays  Int       @default(0)
  /// Kick members who joined after enabledAt and never verified within this many hours (0 = never).
  kickAfterHours     Int       @default(0)
  /// When the gate was last switched on: only members who joined after this can ever be kicked for not verifying.
  enabledAt          DateTime?
  updatedAt          DateTime  @updatedAt
}

/// Raid protection (singleton, id 1): an alarm, and an optional reaction, when many accounts join at once.
model RaidConfig {
  id             Int       @id @default(1)
  enabled        Boolean   @default(false)
  joinThreshold  Int       @default(8)
  windowSeconds  Int       @default(30)
  /// alert | timeout | kick (CHECK in the migration)
  action         String    @default("alert") @db.VarChar(8)
  actionMinutes  Int       @default(60)
  raidMinutes    Int       @default(20)
  /// While in the future, raid mode is on (kept here so a restart doesn't end it).
  activeUntil    DateTime?
  lastRaidAt     DateTime?
  updatedAt      DateTime  @updatedAt
}

/// The dashboard's audit trail: who changed what and when. Arguments are never stored (they can hold secrets or members' text).
model AuditEntry {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String   @db.VarChar(64)
  actorName String   @db.VarChar(100)
  actorRole String   @db.VarChar(16)
  /// The part of the dashboard (the module), e.g. "twitch".
  area      String   @db.VarChar(40)
  /// What was done, e.g. "saveStreamer".
  action    String   @db.VarChar(60)
  /// A short id the action was about, when it had one.
  target    String   @default("") @db.VarChar(64)

  @@index([at])
  @@index([area, at])
}

/// How a member joined: which invite (and so who invited them), when, and whether they have left. One row per join.
model MemberInvite {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(20)
  userName    String    @db.VarChar(100)
  inviterId   String?   @db.VarChar(20)
  inviterName String?   @db.VarChar(100)
  code        String?   @db.VarChar(32)
  /// invite | vanity | unknown (CHECK in the migration)
  source      String    @db.VarChar(8)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  @@index([inviterId])
  @@index([userId])
  @@index([joinedAt])
}

/// A ticket category: its own button on the panel, optionally its own Discord category and its own staff roles.
model TicketCategory {
  id                String   @id @default(cuid())
  label             String   @db.VarChar(80)
  /// Unicode emoji or <:name:id>, "" for none.
  emoji             String   @default("") @db.VarChar(64)
  /// Where its ticket channels are made; null = the general ticket category.
  discordCategoryId String?  @db.VarChar(20)
  /// Who sees and handles its tickets; empty = the general staff roles.
  staffRoleIds      String[] @default([])
  position          Int      @default(0)
  createdAt         DateTime @default(now())
}

/// The screening queue settings (singleton, id 1).
model ScreeningConfig {
  id             Int      @id @default(1)
  enabled        Boolean  @default(false)
  /// The staff channel where each new member's card is posted.
  channelId      String?  @db.VarChar(20)
  approvedRoleId String?  @db.VarChar(20)
  /// Given on join, taken away on approval (optional).
  pendingRoleId  String?  @db.VarChar(20)
  updatedAt      DateTime @updatedAt
}

/// One new member waiting for (or past) a staff decision.
model ScreeningEntry {
  id               String    @id @default(cuid())
  userId           String    @db.VarChar(20)
  userName         String    @db.VarChar(100)
  accountCreatedAt DateTime
  joinedAt         DateTime  @default(now())
  /// pending | approved | rejected | left (CHECK in the migration)
  status           String    @default("pending") @db.VarChar(10)
  decidedByName    String?   @db.VarChar(100)
  decidedAt        DateTime?
  /// The card in the staff channel, so it can be updated.
  channelId        String?   @db.VarChar(20)
  messageId        String?   @db.VarChar(20)

  @@index([status, joinedAt])
  @@index([userId])
}

/// A saved starting point for announcements (text, embed, channel and ping role), so the team doesn't retype them.
model AnnouncementTemplate {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(60)
  content          String   @default("") @db.VarChar(2000)
  embedEnabled     Boolean  @default(false)
  embedTitle       String   @default("") @db.VarChar(256)
  embedDescription String   @default("") @db.VarChar(4000)
  embedColor       Int      @default(65448)
  embedImageUrl    String   @default("") @db.VarChar(500)
  channelId        String?  @db.VarChar(20)
  pingRoleId       String?  @db.VarChar(20)
  createdByName    String   @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---- event calendar -------------------------------------------------------------------
// Reads a public calendar (.ics), posts the events that match a rule (one message per event) and keeps one overview message up to date.

/// Singleton (id 1).
model EventCalendarConfig {
  id                Int       @id @default(1)
  enabled           Boolean   @default(false)
  /// An https address of a public iCalendar feed.
  icsUrl            String    @default("https://calendar.google.com/calendar/ical/c_10fomfvgafp5atjgb2t8i190i4%40group.calendar.google.com/public/basic.ics") @db.VarChar(500)
  /// Where the overview message lives; null = no overview.
  overviewChannelId String?   @db.VarChar(20)
  overviewMessageId String?   @db.VarChar(20)
  /// Fingerprint of what the overview shows, so it is only edited when something changed.
  overviewHash      String    @default("") @db.VarChar(40)
  overviewDays      Int       @default(30)
  /// Where the detailed monthly summary is posted; null = none.
  summaryChannelId  String?   @db.VarChar(20)
  /// "YYYY-MM" of the posted summary, its messages (it can need several), and a fingerprint of what it shows.
  summaryMonth      String?   @db.VarChar(7)
  summaryMessageIds String[]  @default([])
  summaryHash       String    @default("") @db.VarChar(40)
  /// false until the first successful check, which only remembers what is there (nothing is announced).
  baselined         Boolean   @default(false)
  lastCheckedAt     DateTime?
  /// "ok", "http 404", "blocked", "timeout", "parse", "empty" ... of the last check.
  lastStatus        String?   @db.VarChar(40)
  updatedAt         DateTime  @updatedAt
}

/// "Events whose name contains X (or that carry tag Y) go to channel Z."
model EventRule {
  id         String      @id @default(cuid())
  name       String      @db.VarChar(60)
  words      String[]    @default([])
  categories String[]    @default([])
  channelId  String      @db.VarChar(20)
  pingRoleId String?     @db.VarChar(20)
  daysAhead  Int         @default(7)
  enabled    Boolean     @default(true)
  /// false until the rule's first check, which only remembers what matches (a new rule never posts old events).
  seeded     Boolean     @default(false)
  /// Use an AI-written summary (rewards, who can take part) when the bot has one configured.
  useAi      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  posts      EventPost[]
  /// null = the main calendar; otherwise an article-only source (one game).
  sourceId   String?
  source     EventSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Also matches events of these kinds (drop, event, update, sale, other).
  kinds      String[]    @default([])
  /// Attach a drawn picture (drop card / event card) to the posts.
  useCard    Boolean     @default(false)
  /// Also announce every occurrence of a repeating series ("Every Tuesday"), not just list it.
  postSeries Boolean     @default(false)
  /// Days before the start at which the event is posted: the first is the announcement, the later ones are reminders (for example 7 and 2).
  leadDays   Int[]       @default([7])
}

/// An occurrence that was posted (or silently remembered) for a rule. Unique per rule and occurrence, so nothing is posted twice.
model EventPost {
  id        String    @id @default(cuid())
  ruleId    String
  rule      EventRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventKey  String    @db.VarChar(160)
  startsAt  DateTime
  /// Null = remembered silently (first check).
  messageId String?   @db.VarChar(20)
  channelId String    @db.VarChar(20)
  hash      String    @db.VarChar(40)
  /// The event's name, for the dashboard list.
  title     String    @default("") @db.VarChar(120)
  /// Which of the rule's lead times this post is for (0 = the first / announcement).
  stage     Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([ruleId, eventKey, stage])
  @@index([startsAt])
}

/// A monthly news article pasted by an admin ("This Month in Sea of Thieves"). Its sections add dates and details the calendar lacks.
model EventArticle {
  id             String   @id @default(cuid())
  /// "YYYY-MM" of the article (from its byline), only to show and replace.
  monthKey       String   @db.VarChar(7)
  title          String   @db.VarChar(200)
  text           String   @db.Text
  importedByName String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  /// null = the main calendar's articles.
  sourceId       String?
  source         EventSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// Another game whose events come only from pasted articles (for example Hunt: Showdown). Same state as the main calendar, own rules, articles, overview and monthly summary.
model EventSource {
  id                String    @id @default(cuid())
  name              String    @db.VarChar(40)
  enabled           Boolean   @default(true)
  overviewChannelId String?   @db.VarChar(20)
  overviewMessageId String?   @db.VarChar(20)
  overviewHash      String    @default("") @db.VarChar(40)
  overviewDays      Int       @default(30)
  summaryChannelId  String?   @db.VarChar(20)
  summaryMonth      String?   @db.VarChar(7)
  summaryMessageIds String[]  @default([])
  summaryHash       String    @default("") @db.VarChar(40)
  /// true from the start: an article-only source has no old posts to protect (rules still seed themselves silently).
  baselined         Boolean   @default(true)
  lastCheckedAt     DateTime?
  lastStatus        String?   @db.VarChar(40)
  createdAt         DateTime  @default(now())
  /// A public iCalendar feed (optional).
  icsUrl            String?   @db.VarChar(500)
  /// A page address with {month} {mm} {year} tokens, fetched for this and next month (optional).
  pageUrlTemplate   String?   @db.VarChar(300)
  /// CSS selector that narrows the fetched page to the article (optional).
  contentSelector   String?   @db.VarChar(200)
  /// auto = plain request, then the browser service when blocked; plain; crawl4ai.
  fetchMode         String    @default("auto") @db.VarChar(10)
  lastFetchedAt     DateTime?
  lastFetchStatus   String?   @db.VarChar(40)
  /// Set while the bot is reading this source's calendar and pages (the dashboard shows "fetching now").
  syncStartedAt     DateTime?
  /// Post the monthly summary by itself when a new month has events.
  summaryAuto       Boolean   @default(false)
  /// The look of the drawn pictures of this game, and whether the monthly summary comes with a picture.
  accentColor       String    @default("#00ffa8") @db.VarChar(7)
  /// When events of a kind are announced (days before the start per kind, e.g. {"drop":[7,2]}); a kind not set falls back to the rule's own times.
  reminderDefaults  Json      @default("{}")
  summaryImage      Boolean   @default(false)
  /// Anyone may read this game's upcoming events (public widget page and JSON); off by default.
  publicWidget      Boolean   @default(false)
  /// A page listing the game's patch notes (optional); new ones are announced in patchChannelId.
  patchListUrl      String?   @db.VarChar(300)
  patchChannelId    String?   @db.VarChar(20)
  patchPingRoleId   String?   @db.VarChar(20)
  /// false until the first successful look at the list (which only remembers what is there).
  patchBaselined    Boolean   @default(false)
  patchCheckedAt    DateTime?
  patchStatus       String?   @db.VarChar(40)
  patchNotes        PatchNote[]
  background        EventSourceImage?
  items             EventItem[]
  rules             EventRule[]
  articles          EventArticle[]
  events            GameEvent[]
  fetches           EventFetch[]
}

/// An event the bot knows about, stored so it can be edited, posted, summarised and shown. Synced from the calendar and the articles; manual ones are never touched by a sync.
model GameEvent {
  id          String      @id @default(cuid())
  sourceId    String
  source      EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Stable per occurrence (calendar uid + start, or article|name|date).
  key         String      @db.VarChar(160)
  title       String      @db.VarChar(120)
  /// drop | event | update | sale | other
  kind        String      @default("event") @db.VarChar(8)
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean     @default(false)
  description String      @default("") @db.VarChar(4000)
  summary     String      @default("") @db.VarChar(600)
  blurb       String      @default("") @db.VarChar(200)
  /// everyone | partners | unknown
  audience    String      @default("unknown") @db.VarChar(10)
  items       String[]    @default([])
  categories  String[]    @default([])
  imageUrl    String?     @db.VarChar(500)
  videoUrl    String?     @db.VarChar(500)
  color       Int?
  /// calendar | article | manual
  origin      String      @db.VarChar(10)
  /// An admin edited it: a sync never overwrites its fields.
  locked      Boolean     @default(false)
  lastSeenAt  DateTime    @default(now())
  removedAt   DateTime?
  createdAt   DateTime    @default(now())
  /// Overrides the rules' lead times for this one event (days before the start); empty = use the rules'.
  reminderDays Int[]      @default([])
  /// Set when this one entry stands for a whole repeating series ("Every Tuesday"); such an entry is not posted per occurrence.
  recurrence  String?     @db.VarChar(60)

  @@unique([sourceId, key])
  @@index([sourceId, startsAt])
}

/// The last text seen at an address (a fetched page or a pasted article) and what the AI extracted from it, so an unchanged text costs no new AI call.
model EventFetch {
  id            String      @id @default(cuid())
  sourceId      String
  source        EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// The page address, or "paste:<article id>".
  url           String      @db.VarChar(300)
  contentHash   String      @db.VarChar(40)
  extractedJson String      @db.Text
  status        String      @db.VarChar(30)
  fetchedAt     DateTime    @default(now())

  @@unique([sourceId, url])
}

/// A cached AI summary, keyed by a hash of the event text it came from (so one event costs one call).
model EventSummary {
  hash      String   @id @db.VarChar(40)
  json      String   @db.VarChar(4000)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// An item (a drop reward such as a cosmetic) of a game, with the picture an admin uploaded for it. Rows are created by themselves from the extracted events.
model EventItem {
  id             String      @id @default(cuid())
  sourceId       String
  source         EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// The name normalised (lower case, one space), so "Gilded Phoenix Wheel" always finds the same row.
  key            String      @db.VarChar(80)
  name           String      @db.VarChar(80)
  imageData      Bytes?
  imageType      String?     @db.VarChar(20)
  imageWidth     Int?
  imageHeight    Int?
  imageUpdatedAt DateTime?
  uploadedByName String?     @db.VarChar(100)
  createdAt      DateTime    @default(now())

  @@unique([sourceId, key])
}

/// The background picture of a game's drawn cards (one per game).
model EventSourceImage {
  sourceId       String      @id
  source         EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String      @db.VarChar(20)
  width          Int
  height         Int
  uploadedByName String      @db.VarChar(100)
  uploadedAt     DateTime    @default(now())
}


/// One patch note page the bot has seen at a game's list address (unique per address, so it is announced once).
model PatchNote {
  id        String      @id @default(cuid())
  sourceId  String
  source    EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url       String      @db.VarChar(300)
  title     String      @db.VarChar(200)
  messageId String?     @db.VarChar(20)
  createdAt DateTime    @default(now())

  @@unique([sourceId, url])
}
